# Скопируйте в .env и при необходимости измените значения.
# docker compose автоматически подхватывает .env для подстановки переменных.

POSTGRES_USER=taskflow
POSTGRES_PASSWORD=change_me
POSTGRES_DB=taskflow

# Для работы вне Docker (локальный запуск) замените db на localhost:
# DATABASE_URL=postgresql+psycopg2://taskflow:change_me@localhost:5432/taskflow
